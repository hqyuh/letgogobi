{
  "name": "@letgogobi/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "remove-nx": "rm -r .nx",
    "nx:reset": "nx reset",
    "nx:run-many": "nx run-many",
    "lint": "nx:run-many --target=lint",
    "fix": "pnpm run nx:run-many --target=lint --fix",
    "dev": "pnpm nx:reset && pnpm nx:run-many -t serve",
    "dev:serve": "pnpm nx:run-many -t serve",
    "dev-order-svc": "pnpm dev:serve --projects=order-svc",
    "dev-notification-svc": "pnpm dev:serve --projects=notification-svc",
    "build-all": "pnpm nx:run-many --target=build",
    "kafka:create-topics": "ts-node --transpile-only -r tsconfig-paths/register --project tsconfig.cli.json libs/kafka/src/cli.ts insert:kafka-topics",
    "kafka:delete-topics": "ts-node --transpile-only -r tsconfig-paths/register --project tsconfig.cli.json libs/kafka/src/cli.ts remove:kafka-topics",
    "prisma:migrate": "prisma migrate dev --schema ./prisma",
    "prisma:generate": "prisma generate",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:setup": "prisma migrate reset && prisma migrate dev --name init && prisma generate",
    "prisma:seed": "npx prisma db seed",
    "prisma:deploy": "prisma migrate deploy",
    "debezium:check": "sh debezium/check.sh",
    "debezium:reset": "sh debezium/reset.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@keyv/redis": "^5.1.5",
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.1.10",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "async-retry": "^1.3.3",
    "axios": "^1.6.0",
    "cacheable": "^2.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "keyv": "^5.5.5",
    "lodash": "^4.17.21",
    "nestjs-command": "^3.1.5",
    "nestjs-redlock-universal": "^0.3.0",
    "pg": "^8.16.3",
    "redlock-universal": "^0.8.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/nest": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "20.19.9",
    "@types/pg": "^8.16.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "prisma": "^7.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
